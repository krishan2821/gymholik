{
  "cli": {
    "version": ">= 7.0.0"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "preview",
        "APP_NAME": "Gymholik Preview",
        "APP_PACKAGE_ID": "com.gymholik.app.preview",
        "API_URL": "https://preview-api.gymholik.com"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "production",
        "APP_NAME": "Gymholik",
        "APP_PACKAGE_ID": "com.gymholik.app",
        "API_URL": "https://api.gymholik.com"
      }
    }
  }
}
